DATABASE_URL=sqlite://./sigurado.db?mode=rwc
JWT_SECRET=change-me-to-a-random-32-byte-base64-secret
BIND_ADDR=127.0.0.1:8080
UPLOAD_DIR=./uploads
SESSION_TTL_SECS=120
ENROLL_CODE_TTL_SECS=300
CORS_ORIGIN=http://localhost:5173

# The room's clock. Used for after-hours checks and the dates in the sheet.
LAB_UTC_OFFSET_HOURS=8
SEED_ADMIN_EMAIL=admin@sigurado.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME="Lab Administrator"

# Mirroring the trail into a Google spreadsheet. Off unless all three of the
# first settings are filled in. Set up from Admin > Sheet in the web app.
# SHEETS_ENABLED=true
# SHEETS_SPREADSHEET_ID=the-long-id-between-/d/-and-/edit
# SHEETS_KEY_PATH=./google-service-account.json
# SHEETS_SYNC_SECS=300
