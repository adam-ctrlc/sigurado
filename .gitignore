# ---------------------------------------------------------------- secrets --
# Real credentials and real people's data. Nothing in here is ever publishable.
# Copy backend/.env.example to backend/.env and fill it in locally instead.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
service-account*.json
google-service-account*.json
credentials.json
client_secret*.json
secrets.json

# The audit trail holds password hashes, phone numbers and fingerprint tokens.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal

# Photos people attached to a checkout.
uploads/
backend/uploads/

